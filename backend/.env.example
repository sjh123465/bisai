# ============ LLM 配置 ============
# 推荐 DeepSeek（便宜、Function Calling 好、速度快）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 也可以用 OpenAI 兼容的其他服务（智谱、阿里 DashScope 等）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ============ Embedding 配置 ============
# 用于 GraphRAG 的向量检索。留空则自动回退：EMBEDDING → MULTIMODAL → 主 LLM
# 推荐智谱 embedding-3（同一个智谱 Key 即可，无需额外账号）
EMBEDDING_LOCAL=false
EMBEDDING_MODEL=embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=your_zhipu_api_key

# 阿里百炼备选（OpenAI 兼容）
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxx

# 说明：三个来源全部不可用时会降级为本地字符 bigram 哈希向量（384 维），保证功能不中断
# 更换 Embedding 模型后维度会变，需删除 data/chroma 目录让向量库重建

# ============ 多模态（截图答疑）配置 ============
# 若主模型不支持视觉（如 DeepSeek），需单独配置视觉模型
# 推荐智谱 GLM-4V-Flash（免费，支持图片）：https://bigmodel.cn/
MULTIMODAL_API_KEY=your_zhipu_api_key
MULTIMODAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MULTIMODAL_MODEL=glm-4v-flash
# 留空则尝试复用主 LLM 配置（不支持视觉时会提示配置）

# ============ 沙箱配置 ============
# 沙箱执行超时（秒）
SANDBOX_TIMEOUT=5
# 允许执行的语言（目前仅 python）
SANDBOX_ALLOWED_LANGS=python

# ============ 数据路径 ============
DATA_DIR=./data
CHROMA_DIR=./data/chroma
GRAPH_FILE=./data/knowledge_graph.json

# ============ 服务端口 ============
PORT=8000
HOST=0.0.0.0
