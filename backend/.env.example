# ============================================================
# CodeMentor v2 服务端配置
#
# 重要：模型 API Key 不再写入 .env / 服务端环境变量。
# 学生和教师在前端右上角「配置模型」中填写自己的远程 Key，
# Key 只保存在浏览器，仅在单次请求期间由后端转发使用。
# ============================================================

# ---------- 安全 ----------
# 生产环境必须改成随机长字符串
AUTH_SECRET=change-me-to-a-random-secret
RATE_LIMIT_PER_MIN=60

# ---------- 沙箱 ----------
# auto: 检测到 Docker 用 Docker，否则 subprocess
# subprocess: 直接本机执行（本地演示默认）
# docker: 强制 Docker
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=5
SANDBOX_ALLOWED_LANGS=python
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# ---------- 数据 ----------
DATA_DIR=./data
CHROMA_DIR=./data/chroma
GRAPH_FILE=./data/knowledge_graph.json

# ---------- 我的书架 ----------
BOOKS_DIR=./data/books
# 单文件上传上限（MB），上传采用分块落盘，调大不会整体占用内存
BOOK_MAX_MB=200
# 单本书最大切片数（约 500 字/片），超出会提示拆分上传
BOOK_MAX_CHUNKS=20000
BOOK_CHUNK_SIZE=500
BOOK_CHUNK_OVERLAP=80
BOOK_EMBED_BATCH=32
# 扫描版 PDF 本地 OCR：auto=只识别缺字页 / off=关闭 / force=全部页面
BOOK_OCR_MODE=auto
BOOK_OCR_DPI=150
BOOK_OCR_MAX_PAGES=1000

# ---------- Embedding ----------
# 本地 bge-small（FastEmbed / ONNX）模型下载源。国内网络默认走镜像，
# 否则首次启动可能因 huggingface.co 不可达导致模型加载失败。
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（首次启动下载约 91MB；断网演示前可先预热）
EMBEDDING_CACHE_DIR=./data/models

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8080
